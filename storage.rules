rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cards/{cardId}/{fileName=**} {
      function isCardOwner() {
        return request.auth != null
          && firestore.get(
            /databases/(default)/documents/cards/$(cardId)
          ).data.ownerUid == request.auth.uid;
      }

      // Public read is intentional: anyone with a shared card link can view its media.
      allow read: if true;

      // Only the authenticated card creator can upload or replace media.
      allow create, update: if isCardOwner()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
        );

      allow delete: if isCardOwner();
    }
  }
}
