rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{cardId} {
      function isOwner() {
        return request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }

      function validCard() {
        return request.resource.data.keys().hasOnly([
            'type', 'to', 'from', 'date', 'theme', 'wish',
            'photos', 'musicUrl', 'ownerUid', 'published',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.type in [
            'birthday', 'love', 'thanks', 'friendship',
            'missyou', 'anniversary', 'sorry', 'any'
          ]
          && request.resource.data.to is string
          && request.resource.data.to.size() > 0
          && request.resource.data.to.size() <= 60
          && request.resource.data.from is string
          && request.resource.data.from.size() <= 60
          && request.resource.data.wish is string
          && request.resource.data.wish.size() > 0
          && request.resource.data.wish.size() <= 1200
          && request.resource.data.date is string
          && request.resource.data.theme in ['pink', 'lavender', 'gold']
          && request.resource.data.photos is list
          && request.resource.data.photos.size() <= 5
          && request.resource.data.musicUrl is string
          && request.resource.data.ownerUid is string
          && request.resource.data.published is bool;
      }

      // A receiver can read published cards; the creator can also read drafts.
      allow read: if resource.data.published == true
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validCard();

      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validCard();

      allow delete: if isOwner();
    }
  }
}
